    "exceljs": "^4.4.0",
    "jose": "^6.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.10",
    "papaparse": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
