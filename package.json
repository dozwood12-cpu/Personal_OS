    "test:media": "node tests/media-api.cjs",
    "test:schedule": "node tests/work-schedule-api.cjs",
    "test:storage": "node --conditions=react-server --import tsx tests/storage-runner.cjs",
    "test:storage:browser": "node tests/storage-browser.cjs",
    "test:storage:api": "node tests/storage-api.cjs",
    "test:accounts": "node tests/accounts.cjs"
  },
  "dependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
