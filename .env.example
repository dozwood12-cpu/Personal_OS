SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Google Cloud: enable Drive API, create OAuth Client (Web application), add the exact callback URI.
# External consent screen: In production; Google may require verification for drive scope.
# Server-only values. Generate a 32-byte key with: openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/storage/gdrive/callback
TOKEN_ENCRYPTION_KEY=
